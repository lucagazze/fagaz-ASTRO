---
import Button from './UI/Button.astro';
---

<section class="py-20 bg-background-light relative">
    <div class="container mx-auto px-4 max-w-6xl">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col md:flex-row border border-gray-100">
            <div class="bg-[#15141e] text-white p-10 md:w-2/5 flex flex-col justify-between">
                <div>
                    <h3 class="text-2xl font-bold mb-6 uppercase tracking-wide">Contáctenos</h3>
                    <p class="text-gray-300 mb-8 text-sm leading-relaxed">
                        Estamos listos para atender sus necesidades industriales. Complete el formulario o utilice nuestros canales directos.
                    </p>
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <span class="material-symbols-outlined text-primary-light mt-1">location_on</span>
                            <div>
                                <h5 class="font-bold text-sm uppercase text-gray-400 mb-1">Dirección</h5>
                                <p class="text-sm">Remondino 948, San Lorenzo, Santa Fe</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <span class="material-symbols-outlined text-primary-light mt-1">call</span>
                            <div>
                                <h5 class="font-bold text-sm uppercase text-gray-400 mb-1">Teléfono</h5>
                                <p class="text-sm">+54 9 3476 56-7197</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <span class="material-symbols-outlined text-primary-light mt-1">mail</span>
                            <div>
                                <h5 class="font-bold text-sm uppercase text-gray-400 mb-1">Email</h5>
                                <p class="text-sm">info@fagazsa.com</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-10">
                    <img alt="Fagaz SA Logo White" class="h-12 w-auto opacity-50" src="/logofooter.png"/>
                </div>
            </div>
            <div class="p-10 md:w-3/5">
                <h3 class="text-2xl font-bold text-[#111118] mb-6 uppercase tracking-tight">Envíenos un mensaje</h3>
                <form id="contact-form-section" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nombre</label>
                            <input class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2.5" placeholder="Su nombre" type="text" name="name" required/>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Empresa</label>
                            <input class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2.5" placeholder="Nombre de su empresa" type="text" name="company"/>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Email</label>
                        <input class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2.5" placeholder="correo@ejemplo.com" type="email" name="email" required/>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Servicio de Interés</label>
                        <select class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm py-2.5" name="service">
                            <option>Limpieza Industrial</option>
                            <option>Fumigación</option>
                            <option>Gestión de RRHH</option>
                            <option>Otros Servicios</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Mensaje</label>
                        <textarea class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 text-sm" placeholder="¿En qué podemos ayudarle?" rows="4" name="message" required></textarea>
                    </div>
                    
                    <div id="form-message" class="hidden rounded-lg p-4 text-sm"></div>

                    <Button type="submit" variant="primary" class="w-full py-3 text-sm shadow-lg hover:shadow-xl mt-2">
                        Enviar Consulta
                    </Button>
                </form>

                <script>
                    const form = document.getElementById('contact-form-section') as HTMLFormElement;
                    const messageDiv = document.getElementById('form-message');
                    const submitButton = form?.querySelector('button[type="submit"]');

                    if (form) {
                        form.addEventListener('submit', async (e) => {
                            e.preventDefault();
                            
                            // Disable button and show loading state
                            if (submitButton) {
                                (submitButton as HTMLButtonElement).disabled = true;
                                submitButton.innerHTML = 'Enviando...';
                            }
                            if (messageDiv) messageDiv.classList.add('hidden');

                            const formData = new FormData(form);
                            const data = Object.fromEntries(formData);

                            try {
                                const response = await fetch('/api/send-mail', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    body: JSON.stringify(data),
                                });

                                const result = await response.json();

                                if (response.ok) {
                                    if (messageDiv) {
                                        messageDiv.textContent = result.message || '¡Mensaje enviado con éxito!';
                                        messageDiv.className = 'mt-4 rounded-lg p-4 text-sm bg-green-100 text-green-700 block';
                                    }
                                    form.reset();
                                } else {
                                    throw new Error(result.message || 'Error al enviar el mensaje');
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                if (messageDiv) {
                                    messageDiv.textContent = error instanceof Error ? error.message : 'Ocurrió un error inesperado. Por favor, intente nuevamente.';
                                    messageDiv.className = 'mt-4 rounded-lg p-4 text-sm bg-red-100 text-red-700 block';
                                }
                            } finally {
                                // Re-enable button
                                if (submitButton) {
                                    (submitButton as HTMLButtonElement).disabled = false;
                                    submitButton.innerHTML = 'Enviar Consulta';
                                }
                            }
                        });
                    }
                </script>
            </div>
        </div>
    </div>
</section>
